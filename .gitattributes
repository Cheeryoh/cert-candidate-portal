# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.mdx     text eol=lf
*.sh      text eol=lf
*.env     text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.toml    text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf
Makefile  text eol=lf

# Binary files — do not modify
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.eot     binary
*.pdf     binary
*.zip     binary
*.tar.gz  binary
*.tgz     binary
*.pem     binary
*.p12     binary
*.pfx     binary

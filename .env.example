# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Supabase Admin (seed script only — never expose to client) ───────────────
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Seed password (required by scripts/seed.ts) ───────────────────────────────
# Strong password (min 12 chars) given to all demo candidates.
# Rotate after each demo cycle. Never commit the actual value.
SEED_PASSWORD=change-me-before-seeding

# ── Demo auto-fill (optional) ────────────────────────────────────────────────
# When NEXT_PUBLIC_DEMO_MODE=true the login form pre-populates with the values
# below and shows a "Demo access" pill.  Toggle by setting/removing the variable
# in Vercel → Environment Variables → Redeploy.
# WARNING: NEXT_PUBLIC_ values are embedded in the JS bundle and visible to
# anyone who inspects the page source.  Only use a dedicated demo account.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=alice@example.com
NEXT_PUBLIC_DEMO_PASSWORD=change-me-to-seed-password

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# Salt used when hashing client IPs for the login_rate_limits table.
# Any random string works. Changing it invalidates existing rate-limit records.
RATE_LIMIT_SALT=change-me-to-a-random-string
